{
  "name": "thrivelle",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:patient": "turbo run dev --filter=@thrivelle/patient-portal",
    "dev:clinician": "turbo run dev --filter=@thrivelle/clinician-dashboard",
    "dev:docs": "turbo run dev --filter=@thrivelle/docs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "supabase": "^2.115.0",
    "turbo": "^2.10.4",
    "typescript": "^5.7.0"
  }
}
